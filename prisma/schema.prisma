generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  PAUSED
  PARTIAL
}

// Task 2.1: Strongly-typed status field — prevents typos like "RUNING" or "Done"
// at both compile-time (Prisma codegen) and DB-level (PostgreSQL constraint).
enum PipelineJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum EmailStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  FAILED
  BOUNCED
  COMPLAINED
  QUOTA_EXCEEDED
}

model User {
  id           String      @id @default(uuid())
  clerkId      String      @unique
  email        String      @unique
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?     // Encrypted in the DB using AES-256-GCM
  senderEmail  String?
  senderName   String?
  resendApiKey String?     // Encrypted in the DB using AES-256-GCM
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspaces   Workspace[]
}

model Workspace {
  id           String        @id @default(uuid())
  name         String
  description  String?
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]
  leads        Lead[]
  unsubscribes Unsubscribe[]
  pipelineJobs PipelineJob[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Lead {
  id             String         @id @default(uuid())
  companyName    String         @default("Unknown")
  prospectName   String         @default("Prospect")
  email          String
  phone          String?
  role           String         @default("Unknown")
  scrapedFromUrl String
  isEnriched     Boolean        @default(false)
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipelineJobId  String?
  pipelineJob    PipelineJob?   @relation(fields: [pipelineJobId], references: [id], onDelete: SetNull)
  campaignLeads  CampaignLead[]
  emailLogs      EmailLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([pipelineJobId])
}

model Campaign {
  id             String         @id @default(uuid())
  name           String
  goal           String?
  targetAudience String?
  status         CampaignStatus @default(DRAFT)
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailLogs      EmailLog[]
  campaignLeads  CampaignLead[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  @@index([workspaceId, createdAt(sort: Desc)])
}

// Join table linking a Campaign to its target Leads
model CampaignLead {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([campaignId, leadId])
  @@index([campaignId])
  @@index([leadId])
}

model EmailLog {
  id            String      @id @default(uuid())
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  recipient     String
  subject       String
  content       String
  status        EmailStatus @default(PENDING)
  resendId      String?     @unique
  smtpMessageId String?     @unique
  sentAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([campaignId, status])
  @@index([campaignId, createdAt(sort: Desc)])
  @@index([leadId])
}

// Stores opt-out requests for GDPR/CAN-SPAM compliance
model Unsubscribe {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  reason      String?
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, email])
  @@index([workspaceId, email])
}

model PipelineJob {
  id            String    @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prompt        String
  status        PipelineJobStatus @default(QUEUED)
  totalUrls     Int       @default(0)
  processedUrls Int       @default(0)
  leadsFound    Int       @default(0)
  pendingValidations Int  @default(0)
  errorMessage  String?
  leads         Lead[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, createdAt(sort: Desc)])
}
