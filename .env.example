# ============================================================
# HyperDrive AI — Environment Variables Reference
# Copy this file to .env and fill in real values.
# Variables marked [REQUIRED] must be set for the app to start.
# Variables marked [OPTIONAL] enhance functionality but aren't blocking.
# ============================================================

# ─── DOCKER COMPOSE DEFAULTS ──────────────────────────────────
# If you are running via `docker compose up`, the following are
# auto-configured by docker-compose.yml and do NOT need to be set here:
#   - DATABASE_URL   → postgresql://hyperdrive:hyperdrive@postgres:5432/hyperdrive_db
#   - REDIS_URL      → redis://redis:6379
#   - BROWSERLESS_URL → http://browserless:3000
# Only set these below if you are running OUTSIDE of Docker.
# ──────────────────────────────────────────────────────────────

# ─── Database ──────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# [OPTIONAL] Database migration strategy used at container startup.
# Default (unset): runs `prisma db push` — safe for self-hosted Docker deployments.
# Set to "true" if you are using a managed DB (Neon, Supabase, PlanetScale, etc.)
# to use `prisma migrate deploy` instead, which applies committed migration files safely.
# PRISMA_MIGRATE=true

# ─── Clerk Authentication ──────────────────────────────────────
# [REQUIRED] From Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder"
CLERK_PUBLISHABLE_KEY="pk_test_placeholder"
CLERK_SECRET_KEY="sk_test_placeholder"

# [REQUIRED] Clerk route configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# [REQUIRED] From Clerk Dashboard → Webhooks → Signing Secret
CLERK_WEBHOOK_SECRET="whsec_placeholder"

# ─── Web Scraper ──────────────────────────────────────────────
# [REQUIRED] Google Search API via Serper.dev — required for the lead-gen agent to run
# Sign up for free at https://serper.dev → Dashboard → API Key
SERPER_API_KEY="your_serper_api_key_here"

# ─── AI Providers ─────────────────────────────────────────────
# [REQUIRED] Primary LLM — free tier at console.groq.com
GROQ_API_KEY="gsk_placeholder"
# [OPTIONAL] Rotate multiple Groq keys for higher throughput (comma-separated)
# GROQ_API_KEYS="gsk_key1,gsk_key2,gsk_key3"

# [OPTIONAL] Faster extraction LLM — free tier at cloud.cerebras.ai
# CEREBRAS_API_KEY="your_cerebras_api_key_here"
# [OPTIONAL] Rotate multiple Cerebras keys (comma-separated)
# CEREBRAS_API_KEYS="key1,key2,key3"

# [OPTIONAL] Fallback LLM — free tier at aistudio.google.com
# GEMINI_API_KEY="your_gemini_api_key_here"
# GEMINI_API_KEYS="key1,key2"

# ─── Email (Resend) ───────────────────────────────────────────
# [OPTIONAL] Platform-level fallback email sender (resend.com)
# Users can also bring their own Resend API key or SMTP via Settings.
RESEND_API_KEY="re_placeholder"

# [REQUIRED if using Resend] Verified sender address
# ⚠️  PRODUCTION: Must be a verified custom domain (NOT onboarding@resend.dev)
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# [OPTIONAL] Resend webhook signing secret (from Resend Dashboard → Webhooks)
RESEND_WEBHOOK_SECRET="whsec_placeholder"

# ─── Security ─────────────────────────────────────────────────
# [REQUIRED] 64-char hex string for AES-256-GCM encryption of BYOK credentials
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="generate_with_command_above"

# [REQUIRED] Authenticates scheduled cron job → /api/cron/* endpoints
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="generate_with_command_above"

# ─── Browserless (JS-Rendered Page Crawling) ──────────────────
# [OPTIONAL] Headless Chrome for scraping React/Vue SPAs.
# Without this, JS-heavy sites return empty pages and no leads are found.
#
# Docker Compose: Auto-configured to http://browserless:3000 (no action needed)
# Local dev:      docker run -p 3001:3000 ghcr.io/browserless/chromium:latest
#                 → set BROWSERLESS_URL=http://localhost:3001
# BROWSERLESS_URL="http://localhost:3001"

# ─── Upstash Redis ────────────────────────────────────────────
# [OPTIONAL] Distributed rate limiting for AI agent routes
# Free tier: upstash.com (no credit card required)
# UPSTASH_REDIS_REST_URL="https://your-endpoint.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your_token_here"

# ─── BullMQ Job Queue ─────────────────────────────────────────
# [REQUIRED] Redis connection URL for the BullMQ async lead-gen pipeline.
# Without this, POST /api/agent will fail to enqueue jobs and the pipeline
# will not run at all.
#
# Local dev:   redis://localhost:6379
#   → docker run -p 6379:6379 redis:alpine
#
# Production:  Use a managed Redis instance with a rediss:// TLS URL
#   → Upstash:         rediss://:token@host:6380   (upstash.com)
#   → Redis Cloud:     redis://user:pass@host:port  (redis.io)
#   → DigitalOcean DB: rediss://user:pass@host:port (managed DB)
REDIS_URL="redis://localhost:6379"

# ─── Application ──────────────────────────────────────────────
# [REQUIRED] Your production URL (used for SEO, OG tags, sitemap, robots.txt)
# ⚠️  PRODUCTION: Set to your actual domain (e.g., https://hyperdrive.ai)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [OPTIONAL] Maximum emails sent per day across all campaigns (default: 1000)
# Increase this to match your SMTP provider's or Resend plan's daily sending limit.
# Must be a positive integer. Invalid values fall back to the default of 1000.
# DAILY_EMAIL_LIMIT=1000

# ─── Testing (Development Only) ──────────────────────────────
# [OPTIONAL] Playwright E2E test credentials (DO NOT set in production)
# E2E_CLERK_EMAIL="test@example.com"
# E2E_CLERK_PASSWORD="test_password"
